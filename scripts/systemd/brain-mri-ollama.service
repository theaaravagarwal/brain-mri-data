[Unit]
Description=Local metadata-only Ollama service for Brain MRI research prototype
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/.ollama/models
Environment=OLLAMA_KEEP_ALIVE=10m
ExecStart=%h/Documents/.aa/brain/.tools/ollama/bin/ollama serve
Restart=on-failure
RestartSec=3
UMask=0077
PrivateTmp=true

[Install]
WantedBy=default.target

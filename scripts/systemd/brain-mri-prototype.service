[Unit]
Description=Brain MRI research prototype
After=network-online.target brain-mri-ollama.service
Wants=network-online.target brain-mri-ollama.service

[Service]
Type=simple
WorkingDirectory=%h/Documents/.aa/brain/monitor
Environment=PATH=%h/Documents/.aa/brain/.tools/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=MONITOR_BIND_HOST=100.64.0.7
Environment=MONITOR_PUBLIC_HOSTS=100.64.0.1,100.64.0.7
Environment=MONITOR_PORT=4173
Environment=MONITOR_NVIDIA_TARGET=software@100.64.0.1
Environment=MONITOR_AMD_TARGET=theaa@100.64.0.3
Environment=MONITOR_SSH_IDENTITY=/home/software/.ssh/brain_mri_monitor_ed25519
Environment=MONITOR_SSH_TIMEOUT_MS=15000
Environment="BRAIN_MRI_INFERENCE_DEVICE=NVIDIA GeForce RTX 4090 Laptop GPU"
Environment=BRAIN_MRI_LLM_MODEL=qwen3:4b
Environment=BRAIN_MRI_OLLAMA_HOST=http://127.0.0.1:11434
Environment=BRAIN_MRI_DEMO_DIR=%h/Documents/.aa/brain/data/raw/brats2020_kaggle/BraTS2020_TrainingData/MICCAI_BraTS2020_TrainingData/BraTS20_Training_341
ExecStart=%h/Documents/.aa/brain/.tools/node/bin/node server.mjs
Restart=on-failure
RestartSec=3
UMask=0077
PrivateTmp=true

[Install]
WantedBy=default.target

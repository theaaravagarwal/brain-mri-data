[Unit]
Description=Brain MRI stable Tailscale entrypoint proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/.aarav/brain/monitor
Environment=PATH=%h/Documents/.aarav/brain/.tools/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=BRAIN_MRI_PROXY_BIND=100.64.0.1
Environment=BRAIN_MRI_PROXY_PORT=4173
Environment=BRAIN_MRI_PROXY_TARGET=http://100.64.0.7:4173
ExecStart=%h/Documents/.aarav/brain/.tools/node/bin/node tailnet-proxy.mjs
Restart=always
RestartSec=3
UMask=0077
PrivateTmp=true

[Install]
WantedBy=default.target

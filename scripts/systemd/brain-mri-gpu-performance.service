[Unit]
Description=Brain MRI Lenovo maximum-power and battery-care settings
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'printf max-power > /sys/firmware/acpi/platform_profile'
ExecStart=/bin/sh -c 'printf Long_Life > /sys/class/power_supply/BAT0/charge_types'
ExecStart=/usr/bin/nvidia-smi -pm 1
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

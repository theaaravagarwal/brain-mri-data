[Unit]
Description=Brain MRI RTX 4090 performance power limit
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'printf max-power > /sys/firmware/acpi/platform_profile'
ExecStart=/bin/sh -c 'printf Long_Life > /sys/class/power_supply/BAT0/charge_types'
ExecStart=/usr/bin/nvidia-smi -pm 1
ExecStart=/usr/bin/nvidia-smi -pl 175
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=Durable RTX 3060 Brain MRI CNN continuation queue
After=brain-mri-cnn-3060-queue.service
Wants=brain-mri-cnn-3060-queue.service

[Service]
Type=simple
WorkingDirectory=%h/Documents/brain-mri-data
Environment=QUEUE_WAIT_FOR_UNIT=brain-mri-cnn-3060-queue.service
ExecStart=%h/Documents/brain-mri-data/scripts/run_durable_cuda_queue.sh prototype-cnn-rtx3060-continuation data/manifests/glioma.pilot.full.v3.batch4.json training/profiles/cuda-batch4.yaml 100 brats:20260903
Restart=on-failure
RestartSec=30
Nice=10
UMask=0077

[Install]
WantedBy=default.target
